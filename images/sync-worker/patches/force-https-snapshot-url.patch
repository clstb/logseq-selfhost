+(defn- snapshot-stream-url [request graph-id]
+  ;; Behind a TLS-terminating reverse proxy the internal request URL is http.
+  ;; Force https so returned URLs are externally reachable with auth headers.
+  (let [url (js/URL. (.-url request))]
+    (str "https://" (.-host url) "/sync/" graph-id "/snapshot/stream")))
 
